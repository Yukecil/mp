<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>个人名片 | Personal Card</title>
    <!-- 引入图标库 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", Helvetica, Arial, sans-serif;
        }

        :root {
            --card-bg: rgba(255, 255, 255, 0.08);
            --card-border: rgba(255, 255, 255, 0.15);
            --primary-color: #c084fc;
            --text-main: #f8fafc;
            --text-sub: #cbd5e1;
        }

        body {
            /* 背景图将由 config.js 动态注入 */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            perspective: 1000px;
        }

        .bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 5, 29, 0.45);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 0;
        }

        .card-container {
            position: relative;
            z-index: 1;
            width: 380px;
            padding: 40px 25px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 28px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5),
                        inset 0 1px 2px rgba(255, 255, 255, 0.2);
            text-align: center;
            transform-style: preserve-3d;
            transition: transform 0.1s ease-out, box-shadow 0.3s ease;
        }

        .avatar-wrapper {
            position: relative;
            width: 95px;
            height: 95px;
            margin: 0 auto 18px;
        }

        .avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .status-dot {
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 14px;
            height: 14px;
            background-color: #34d399;
            border: 2.5px solid #1e1b4b;
            border-radius: 50%;
        }

        .name {
            font-size: 1.4rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .title {
            font-size: 0.85rem;
            color: var(--primary-color);
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .bio {
            font-size: 0.88rem;
            color: var(--text-sub);
            line-height: 1.5;
            margin-bottom: 22px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 24px;
        }

        .ios-icon-btn {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 1.3rem;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .ios-icon-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-4px) scale(1.05);
            border-color: var(--primary-color);
            box-shadow: 0 10px 25px rgba(192, 132, 252, 0.3);
            color: #fff;
        }

        .donate-section {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 16px 14px;
            backdrop-filter: blur(10px);
        }

        .donate-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .donate-title i {
            color: #f472b6;
        }

        .glass-capsule {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 10px 12px;
            border-radius: 12px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.75rem;
            color: #e2e8f0;
            word-break: break-all;
            cursor: pointer;
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.1),
                        0 4px 10px rgba(0, 0, 0, 0.2);
            transition: all 0.2s ease;
            position: relative;
        }

        .glass-capsule:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            border-color: var(--primary-color);
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.2),
                        0 6px 15px rgba(192, 132, 252, 0.25);
        }

        .glass-capsule::after {
            content: "点击复制";
            display: block;
            font-size: 0.65rem;
            color: var(--text-sub);
            margin-top: 4px;
            font-family: -apple-system, sans-serif;
            font-weight: normal;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            background: rgba(192, 132, 252, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #fff;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 0.85rem;
            backdrop-filter: blur(10px);
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
            pointer-events: none;
            box-shadow: 0 10px 25px rgba(192, 132, 252, 0.4);
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 480px) {
            .card-container {
                width: 90%;
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-overlay"></div>

    <div class="card-container" id="card">
        <div class="avatar-wrapper">
            <img id="avatar-img" src="" alt="Avatar" class="avatar">
            <span class="status-dot"></span>
        </div>

        <h1 class="name" id="profile-name"></h1>
        <p class="title" id="profile-title"></p>
        <p class="bio" id="profile-bio"></p>

        <div class="social-links">
            <a id="tg-link" href="#" target="_blank" class="ios-icon-btn" title="Telegram">
                <i class="fab fa-telegram-plane"></i>
            </a>
            <a id="email-link" href="#" class="ios-icon-btn" title="Email">
                <i class="far fa-envelope"></i>
            </a>
        </div>

        <div class="donate-section">
            <div class="donate-title">
                <i class="fas fa-heart"></i> 打赏网络乞丐
            </div>
            <div class="glass-capsule" id="trc20-capsule" onclick="copyTRC20()">
                加载中...
            </div>
        </div>
    </div>

    <div class="toast" id="toast">✨ TRC20 地址已成功复制！</div>

    <!-- 引入私密配置文件 -->
    <script src="config.js"></script>

    <script>
        // 动态加载配置数据到页面
        if (typeof cardConfig !== 'undefined') {
            document.body.style.backgroundImage = `url('${cardConfig.bgImage}')`;
            document.getElementById('avatar-img').src = cardConfig.avatar;
            document.getElementById('profile-name').textContent = cardConfig.name;
            document.getElementById('profile-title').textContent = cardConfig.title;
            document.getElementById('profile-bio').textContent = cardConfig.bio;
            document.getElementById('tg-link').href = cardConfig.telegramUrl;
            document.getElementById('email-link').href = `mailto:${cardConfig.email}`;
            
            const capsule = document.getElementById('trc20-capsule');
            capsule.textContent = cardConfig.trc20Address;
            capsule.setAttribute('onclick', `copyTRC20('${cardConfig.trc20Address}')`);
        }

        // 3D 悬停效果
        const card = document.getElementById('card');
        document.addEventListener('mousemove', (e) => {
            const xAxis = (window.innerWidth / 2 - e.pageX) / 30;
            const yAxis = (window.innerHeight / 2 - e.pageY) / 30;
            card.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });
        document.addEventListener('mouseleave', () => {
            card.style.transform = `rotateY(0deg) rotateX(0deg)`;
            card.style.transition = 'transform 0.5s ease';
        });
        document.addEventListener('mouseenter', () => {
            card.style.transition = 'none';
        });

        // 复制功能
        function copyTRC20(address) {
            navigator.clipboard.writeText(address).then(() => {
                const toast = document.getElementById('toast');
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 2500);
            });
        }
    </script>
</body>
</html>
